import { db } from "./firebaseConfig"; // Ajuste o caminho para o seu arquivo de configuração do Firebase
import { collection, addDoc, doc, getDoc, serverTimestamp } from "firebase/firestore";

// Interface que define a estrutura de um Personagem
export interface Personagem {
  id: string;
  nome: string;
  classe: string;
  nivel: number;
  xp: number;
  userId: string;
  criadoEm: any;
}

// ---------------------------------------------------------------------------
// CRIAR UM PERSONAGEM
// ---------------------------------------------------------------------------
export async function criarPersonagem(nome: string, classe: string, uid: string): Promise<string> {
  // 🐛 BUG 05 CORRIGIDO: Nome da coleção alterado para "personagens" (plural)
  const ref = await addDoc(collection(db, "personagens"), {
    nome,
    classe,
    nivel: 1,
    xp: 0,
    userId: uid,
    criadoEm: serverTimestamp(),
  });
  
  return ref.id;
}

// ---------------------------------------------------------------------------
// BUSCAR UM PERSONAGEM
// ---------------------------------------------------------------------------
export async function buscarPersonagem(id: string): Promise<Personagem | null> {
  // Busca na coleção correta "personagens"
  const snap = await getDoc(doc(db, "personagens", id));
  
  if (!snap.exists()) return null;
  
  return { 
    id: snap.id, 
    ...snap.data() 
  } as Personagem;
}
---------------------------------------------------------------------------
    // 🐛 BUG 08 — SECURITY RULES TOTALMENTE ABERTAS
    // ---------------------------------------------------------------------------
    // O que está acontecendo: QUALQUER pessoa no mundo pode ler, criar, editar
    // e deletar QUALQUER documento do banco — sem estar logada, sem verificação
    // de propriedade. Isso é uma brecha de segurança crítica!
    //
    // Por quê? A regra abaixo usa "allow read, write: if true" — o "if true"
    // significa "sempre permitido". Sem condição alguma. Qualquer script
    // malicioso pode apagar todos os personagens de todos os usuários.
    //
    // CORREÇÃO: substitua as regras abaixo por estas regras seguras:
    //
     match /personagens/{personagemId} {
      allow read: if request.auth != null &&
                  request.auth.uid == resource.data.userId;
      allow create: if request.auth != null &&
                    request.auth.uid == request.resource.data.userId;
       allow update, delete: if request.auth != null &&
                            request.auth.uid == resource.data.userId;
     }
    
    // Com essas regras: usuário só pode ler/editar/deletar documentos onde
    // resource.data.userId == uid do usuário logado (request.auth.uid).
    // ---------------------------------------------------------------------------

    // 🐛 BUG 08 — rules abertas: qualquer um pode fazer qualquer coisa
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
